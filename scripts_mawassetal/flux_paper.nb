Cell[BoxData[
 RowBox[{
  RowBox[{"FUNUdUbCV", "[", 
   RowBox[{"{", 
    RowBox[{
    "Ubx_", ",", "Udx_", ",", "xbx_", ",", "xdx_", ",", "cvx_", ",", "Nax_", ",",
      "offsetx_"}], "}"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Ub", "=", "Ubx"}], ",", 
      RowBox[{"Ud", "=", "Udx"}], ",", 
      RowBox[{"xb", "=", "xbx"}], ",", 
      RowBox[{"xd", "=", "xdx"}], ",", 
      RowBox[{"cv", "=", "cvx"}], ",", 
      RowBox[{"Na", "=", "Nax"}], ",", 
      RowBox[{"offset", "=", "offsetx"}], ",", "shape", ",", "scale", ",", 
      "Probdel", ",", "Probben", ",", "integralben", ",", "integraldel", ",", 
      "f", ",", "g", ",", "xvalue", ",", "dg", ",", "df", ",", "ratio"}], 
     "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{
     "Define", " ", "shape", " ", "and", " ", "scale", " ", "dynamically", " ",
       "based", " ", "on", " ", "the", " ", "input", " ", "CV", " ", "and", " ",
       "mean", " ", 
      RowBox[{"(", "xd", ")"}]}], "*)"}], 
    RowBox[{
     RowBox[{"shape", "=", 
      RowBox[{"1", "/", 
       RowBox[{"cv", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"scale", "=", 
      RowBox[{"xd", "*", 
       RowBox[{"cv", "^", "2"}], "*", 
       RowBox[{"(", 
        RowBox[{"2", "*", "Na"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Probdel", "[", "Nasd_", "]"}], ":=", 
      RowBox[{"PDF", "[", 
       RowBox[{
        RowBox[{"GammaDistribution", "[", 
         RowBox[{"shape", ",", "scale"}], "]"}], ",", 
        RowBox[{"-", "Nasd"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Probben", "[", "sb_", "]"}], ":=", 
      RowBox[{"PDF", "[", 
       RowBox[{
        RowBox[{"ExponentialDistribution", "[", 
         RowBox[{"1", "/", "xb"}], "]"}], ",", "sb"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"integralben", "[", "popsize_", "]"}], ":=", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{
          RowBox[{"Probben", "[", "sb", "]"}], "*", "2", "*", "sb", "*", 
          RowBox[{"Fixmcclandish", "[", 
           RowBox[{"{", 
            RowBox[{"popsize", ",", "sb"}], "}"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"sb", ",", "0", ",", "Infinity"}], "}"}], ",", 
        RowBox[{"MinRecursion", "->", "1"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"integraldel", "[", 
       RowBox[{"popsize_", ",", "Probdelscaled_", ",", "Na_"}], "]"}], ":=", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{
          RowBox[{"Probdelscaled", "[", "Nasd", "]"}], "*", 
          RowBox[{"(", 
           RowBox[{"Nasd", "/", "Na"}], ")"}], "*", 
          RowBox[{"Fixmcclandish", "[", 
           RowBox[{"{", 
            RowBox[{"popsize", ",", 
             RowBox[{"(", 
              RowBox[{"Nasd", "/", 
               RowBox[{"(", 
                RowBox[{"2", "*", "Na"}], ")"}]}], ")"}]}], "}"}], "]"}]}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"Nasd", ",", 
          RowBox[{"-", "Infinity"}], ",", "0"}], "}"}], ",", 
        RowBox[{"MinRecursion", "->", "1"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"f", "[", "popsize_", "]"}], ":=", 
      RowBox[{"popsize", " ", "Ub", " ", 
       RowBox[{"integralben", "[", "popsize", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"g", "[", "popsize_", "]"}], ":=", 
      RowBox[{
       RowBox[{"popsize", " ", "Ud", " ", 
        RowBox[{"integraldel", "[", 
         RowBox[{"popsize", ",", "Probdel", ",", "Na"}], "]"}]}], "-", 
       "offset"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"xvalue", "=", 
      RowBox[{"x", "/.", " ", 
       RowBox[{"FindRoot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"g", "[", "x", "]"}], "+", 
          RowBox[{"f", "[", "x", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "1"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dg", "[", 
       RowBox[{"popsize_", ",", "epsilon_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"g", "[", 
          RowBox[{"popsize", "+", "epsilon"}], "]"}], "-", 
         RowBox[{"g", "[", 
          RowBox[{"popsize", "-", "epsilon"}], "]"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "epsilon"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"df", "[", 
       RowBox[{"popsize_", ",", "epsilon_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"popsize", "+", "epsilon"}], "]"}], "-", 
         RowBox[{"f", "[", 
          RowBox[{"popsize", "-", "epsilon"}], "]"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "epsilon"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ratio", "=", 
      RowBox[{
       RowBox[{"df", "[", 
        RowBox[{"xvalue", ",", "1"}], "]"}], "/", 
       RowBox[{"dg", "[", 
        RowBox[{"xvalue", ",", "1"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"g", "[", "xvalue", "]"}], "+", "offset"}], ",", "xvalue", ",",
        "ratio"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.981714067434332*^9, 3.981714067434332*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"8578194f-b85b-3040-9b13-2c6008fb90b1"],

