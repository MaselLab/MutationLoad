Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Main", " ", "function", " ", "to", " ", "output", " ", "results"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"FUNUdUb", "[", 
    RowBox[{"{", 
     RowBox[{
     "ratioUdUbx_", ",", " ", "Udx_", ",", "xbx_", " ", ",", "xdx_", ",", 
      "Nax_", ",", " ", "offsetx_"}], "}"}], "]"}], ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ratioUdUb", "=", " ", "ratioUdUbx"}], ",", 
       RowBox[{"Ud", "=", "Udx"}], ",", 
       RowBox[{"xb", "=", "xbx"}], ",", 
       RowBox[{"xd", "=", "xdx"}], ",", " ", 
       RowBox[{"Na", "=", "Nax"}], ",", " ", 
       RowBox[{"offset", "=", "offsetx"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Ub", "=", 
       RowBox[{"Ud", "/", "ratioUdUb"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"scale", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"xd", "/", "0.169"}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{"2", "*", "Na"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Probdel", "[", "Nasd_", "]"}], " ", ":=", " ", 
       RowBox[{"PDF", "[", 
        RowBox[{
         RowBox[{"GammaDistribution", "[", 
          RowBox[{"0.169", ",", " ", "scale"}], "]"}], ",", " ", 
         RowBox[{"-", "Nasd"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Probben", "[", "sb_", "]"}], " ", ":=", " ", 
       RowBox[{"PDF", "[", 
        RowBox[{
         RowBox[{"ExponentialDistribution", "[", 
          RowBox[{"1", "/", "xb"}], "]"}], ",", " ", "sb"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"integralben", "[", "popsize_", "]"}], ":=", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"Re", "[", 
          RowBox[{
           RowBox[{"Probben", "[", "sb", "]"}], " ", "*", " ", "2", "*", "sb",
            " ", "*", " ", 
           RowBox[{"Fixmcclandish", "[", 
            RowBox[{"{", 
             RowBox[{"popsize", ",", "sb"}], "}"}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"sb", ",", "0", ",", "Infinity"}], "}"}], ",", 
         RowBox[{"MinRecursion", "->", "1"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"integraldel", "[", 
        RowBox[{"popsize_", ",", "Probdelscaled_", ",", " ", "Na_"}], "]"}], ":=", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"Re", "[", 
          RowBox[{
           RowBox[{"Probdelscaled", "[", "Nasd", "]"}], "*", 
           RowBox[{"(", 
            RowBox[{"Nasd", "/", "Na"}], ")"}], "*", 
           RowBox[{"Fixmcclandish", "[", 
            RowBox[{"{", 
             RowBox[{"popsize", ",", " ", 
              RowBox[{"(", 
               RowBox[{"Nasd", "/", 
                RowBox[{"(", 
                 RowBox[{"2", "*", "Na"}], ")"}]}], ")"}]}], "}"}], "]"}]}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"Nasd", ",", 
           RowBox[{"-", "Infinity"}], ",", "0"}], "}"}], ",", 
         RowBox[{"MinRecursion", "->", "1"}]}], " ", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"f", "[", "popsize_", "]"}], " ", ":=", " ", 
       RowBox[{"popsize", " ", "Ub", " ", 
        RowBox[{"integralben", "[", "popsize", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"g", "[", "popsize_", "]"}], " ", ":=", " ", 
       RowBox[{
        RowBox[{"popsize", " ", "Ud", " ", 
         RowBox[{"integraldel", "[", 
          RowBox[{"popsize", ",", " ", "Probdel", ",", " ", "Na"}], "]"}]}], "-",
         "offset"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"xvalue", " ", "=", " ", 
       RowBox[{"x", " ", "/.", 
        RowBox[{"FindRoot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"g", "[", "x", "]"}], "+", 
           RowBox[{"f", "[", "x", "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", "1"}], "}"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"dg", "[", 
        RowBox[{"popsize_", ",", "epsilon_"}], "]"}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"g", "[", 
            RowBox[{"popsize", "+", "epsilon"}], "]"}], "-", 
           RowBox[{"g", "[", 
            RowBox[{"popsize", "-", "epsilon"}], "]"}]}], ")"}], "/", "2"}], " ",
         "epsilon"}]}], " ", ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"df", "[", 
        RowBox[{"popsize_", ",", "epsilon_"}], "]"}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"f", "[", 
            RowBox[{"popsize", "+", "epsilon"}], "]"}], "-", 
           RowBox[{"f", "[", 
            RowBox[{"popsize", "-", "epsilon"}], "]"}]}], ")"}], "/", "2"}], " ",
         "epsilon"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ratio", " ", "=", 
       RowBox[{
        RowBox[{"df", "[", 
         RowBox[{"xvalue", ",", " ", "1"}], "]"}], "/", 
        RowBox[{"dg", "[", 
         RowBox[{"xvalue", ",", " ", "1"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"g", "[", "xvalue", "]"}], "+", "offset"}], ",", "xvalue", ",",
         " ", "ratio"}], "}"}]}]}], "]"}]}]}]], "Input",
