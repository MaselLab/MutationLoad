            RowBox[{"{", 
             RowBox[{"popsize", ",", " ", 
              RowBox[{"(", 
               RowBox[{"Nasd", "/", 
                RowBox[{"(", 
                 RowBox[{"2", "*", "Na"}], ")"}]}], ")"}]}], "}"}], "]"}]}], 
          "]"}], ",", 
