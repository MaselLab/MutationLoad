 RowBox[{
  RowBox[{
   RowBox[{"NcritMyModel", "[", 
    RowBox[{"{", 
     RowBox[{
     "ratioUdUbx_", ",", " ", "Udx_", ",", "xbx_", " ", ",", "xdx_", ",", 
      "Nax_", ",", " ", "offsetx_"}], "}"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ratioUdUb", "=", "ratioUdUbx"}], ",", 
       RowBox[{"Ud", "=", "Udx"}], ",", 
       RowBox[{"xb", "=", "xbx"}], ",", 
       RowBox[{"Na", " ", "=", " ", "Nax"}], ",", 
       RowBox[{"offset", "=", " ", "offsetx"}], ",", " ", 
       RowBox[{"xd", "=", "xdx"}], ",", " ", "Ub", ",", "g", ",", "f", ",", 
       "xvalue"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Ub", "=", 
       RowBox[{"Ud", "/", "ratioUdUb"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"scale", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"xd", "/", "0.169"}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{"2", "*", "Na"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Probdel", "[", "Nasd_", "]"}], " ", ":=", " ", 
       RowBox[{"PDF", "[", 
        RowBox[{
         RowBox[{"GammaDistribution", "[", 
          RowBox[{"0.169", ",", " ", "scale"}], "]"}], ",", " ", 
         RowBox[{"-", "Nasd"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Probben", "[", "sb_", "]"}], " ", ":=", " ", 
       RowBox[{"PDF", "[", 
        RowBox[{
         RowBox[{"ExponentialDistribution", "[", 
          RowBox[{"1", "/", "xb"}], "]"}], ",", " ", "sb"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"integralben", "[", "popsize_", "]"}], ":=", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"Re", "[", 
          RowBox[{
           RowBox[{"Probben", "[", "sb", "]"}], " ", "*", " ", "2", "*", "sb",
            " ", "*", " ", 
           RowBox[{"Fixmcclandish", "[", 
            RowBox[{"{", 
             RowBox[{"popsize", ",", "sb"}], "}"}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"sb", ",", "0", ",", "Infinity"}], "}"}], ",", 
         RowBox[{"MinRecursion", "->", "1"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"integraldel", "[", 
        RowBox[{"popsize_", ",", "Probdelscaled_", ",", " ", "Na_"}], "]"}], ":=", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"Re", "[", 
          RowBox[{
           RowBox[{"Probdelscaled", "[", "Nasd", "]"}], "*", 
