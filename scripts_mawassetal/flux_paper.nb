        "Wd", ",", "Wb", ",", "Nwf"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Ub", "=", 
       RowBox[{"Ud", "/", "ratioUdUbx"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Coefficient", " ", "of", " ", "Variation", " ", "squared", " ", "for",
         " ", "Gamma", 
        RowBox[{"(", 
         RowBox[{"alpha", ",", "beta"}], ")"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"CV", "^", "2"}], "=", 
        RowBox[{"1", "/", "alpha"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Cd2", "=", 
       RowBox[{"1", "/", "alpha"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Beneficial", " ", "Load", " ", 
         RowBox[{"(", 
          RowBox[{"Whitlock", " ", "Eq", " ", "8", " ", "approximation"}], 
          ")"}]}], ":", 
        RowBox[{"4", "*", "Ne", "*", 
         RowBox[{"sb", "^", "2"}], "*", "Ub"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Note", ":", 
