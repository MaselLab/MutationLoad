#ratio sensitvity to mean sb
dat_cv_kim_1000 <- read.csv("offset_cvvarying_UdUb1000.csv", header = F)
colnames(dat_cv_kim_1000) <- c("cv", "del_flux","Ncrit", "bendelratio")
dat_cv_kim_100 <- read.csv("offset_cvvarying_UdUb100.csv", header = F)
colnames(dat_cv_kim_100) <- c("cv", "del_flux","Ncrit", "bendelratio")
#Ratio
# Top-left plot
p2 <- ggplot() +
geom_line(data = dat_cv_kim_100, aes(x = cv, y = bendelratio, linetype = "mut. rate ratio = 100"), linewidth = line_width) +
geom_line(data = dat_cv_kim_1000, aes(x = cv, y = bendelratio, linetype = "mut. rate ratio = 1000"), linewidth = line_width) +
geom_hline(yintercept = 1, linetype = "dotted", alpha = 0.5, col = "red", linewidth = line_width) +
geom_point(aes(x = 2.4, y = 0.853449), col = "#F05039", shape = 42, size = 7) +
scale_x_log10() +
annotation_logticks(sides = "b",short = unit(0.5, "mm"),
mid = unit(0.75, "mm"),
long = unit(1.25, "mm"),
outside=TRUE)+ coord_cartesian(clip="off")+
scale_linetype_manual(values = c("mut. rate ratio = 100" = 2, "mut. rate ratio = 1000" = 1)) +
scale_y_continuous(breaks= seq(.2,1, by=.2), limits = c(0,1))+
labs(x = bquote(bold(CV)), y = "Drought:Meltdown ratio") +
theme_Publication(base_size = 9) +
theme(axis.title.y = element_blank(),
axis.text.y = element_blank(),
plot.margin = margin(1,0,1,0), legend.position = "none")
p2
dat_cv_kim_1000
