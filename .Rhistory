geom_point(aes(x = 2.432521, y = 3666.41), col = "#F05039", shape = 42, size = 7) +
scale_x_log10() +
annotation_logticks(sides = "b",short = unit(0.5, "mm"),
mid = unit(0.75, "mm"),
long = unit(1.25, "mm"),
outside=TRUE)+ coord_cartesian(clip="off")+
