scale_linetype_manual(values = c("mut. rate ratio = 100" = 2, "mut. rate ratio = 1000" = 1)) +
scale_y_continuous()+
labs(x = bquote(bold(CV)), y = "Drought:Meltdown ratio") +
theme_Publication(base_size = 9) +
theme( legend.position = "none")
p3
dev.off()
